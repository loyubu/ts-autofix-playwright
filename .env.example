# Copy to .env (gitignored) for local runs, or pass each value as -D<property> to Maven.
# CI reads the two required values from GitHub repository secrets.

# Required. Passcode for transsahara.com/manager.            (-Dmanager.passcode)
MANAGER_PASSCODE=

# Required. The n8n feedback form the customer email links to,
# without the ?visit_id=... part.                            (-Dfeedback.form.url)
FEEDBACK_FORM_URL=

# Optional. Defaults to https://transsahara.com              (-Dbase.url)
BASE_URL=

# Optional. Seconds to wait for n8n to score and route a reply. Default 180.
#                                                            (-Drouting.timeout.seconds)
ROUTING_TIMEOUT_SECONDS=

# Optional. false shows the browser window. Default true.    (-Dheadless)
HEADLESS=
