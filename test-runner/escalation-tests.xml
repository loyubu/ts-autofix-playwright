<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!-- Repeat complaint and serious complaint: both escalate, so both send a Slack alert and a
     manager email. -->
<suite name="TS Autofix - escalations" parallel="none">
    <test name="Escalations">
        <groups>
            <run>
                <include name="Escalation"/>
            </run>
        </groups>
        <classes>
            <class name="testcases.FeedbackRoutingTests"/>
        </classes>
    </test>
</suite>
