<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!-- All five routing scenarios, one after another. Escalations send a real Slack alert and
     manager email. Tests run in sequence so n8n handles one reply at a time. -->
<suite name="TS Autofix - all scenarios" parallel="none">
    <test name="Feedback routing">
        <groups>
            <run>
                <include name="Regression"/>
            </run>
        </groups>
        <classes>
            <class name="testcases.FeedbackRoutingTests"/>
        </classes>
    </test>
</suite>
